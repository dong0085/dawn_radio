# Copy to .env.local for `npm run dev`.
# In production, set these as Cloudflare Pages secrets (see README).

# Claude writes the story. Without it, the scripted demo plays.
ANTHROPIC_API_KEY=
# Optional: model and effort (low is fastest; good for live pacing)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# ElevenLabs voices and speech-to-text. Without it, the browser's own voice and recognizer are used.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STT_MODEL=scribe_v2

# Deepl for translation
DEEPL_API_KEY=