{
  "name": "dawn-radio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/version.mjs check && tsc -b && vite build",
    "changes": "node scripts/version.mjs changes",
    "bump": "node scripts/version.mjs bump",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/node/main.ts",
    "deploy": "pnpm build && wrangler pages deploy",
    "preview:cf": "pnpm build && wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply dawn-radio --local",
    "db:migrate": "wrangler d1 migrations apply dawn-radio --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
